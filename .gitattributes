# Keep scripts and reviewed source text identical on all native runners.
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.in text eol=lf
*.desktop text eol=lf
*.iss text eol=lf
LICENSE text eol=lf
NOTICE text eol=lf

# Never normalize cryptographic data, public binary fixtures or artwork.
*.png -text
*.ico -text
*.icns -text
*.ttf -text
*.otf -text
*.pdf -text
*.origin -text
*.bin -text
*.zst -text
*.terminal -text
*.runtime -text
*.r1cs -text
*.pak -text
*.proof -text
*.receipt -text
*.key -text
*.gz -text
*.zip -text
